{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "grapevine-webmcp",
	"main": "src/server.ts",
	"compatibility_date": "2026-06-11",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
	"routes": [
		{
			"pattern": "project-grapevine.preflyhq.com",
			"custom_domain": true
		}
	],
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "grapevine",
			"database_id": "f59f8aeb-5120-4ab9-a07c-01fbdfe31954"
		}
	]
}

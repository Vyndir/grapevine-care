{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "server",
	"main": "src/server.ts",
	"compatibility_date": "2026-06-11",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "grapevine-care",
			"database_id": "00000000-0000-4000-8000-000000000000"
		}
	]
}
